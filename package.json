{
  "name": "chat-interno",
  "version": "1.0.0",
  "description": "Aplicativo de chat interno para equipe",
  "main": "server-simple.js",
  "scripts": {
    "start": "node server-simple.js",
    "dev": "nodemon server-simple.js",
    "setup": "node setup-simple.js",
    "prebuild": "node scripts/check-ai-version.js",
    "build": "esbuild assets/app.js --minify --outfile=assets/app.min.js && esbuild assets/app.css --minify --outfile=assets/app.min.css && node scripts/revision-static-assets.js",
    "pretest": "node scripts/check-ai-version.js --sync",
    "test": "node --test tests/security-regressions.test.js tests/ai-versioning.test.js",
    "ai:version:sync": "node scripts/check-ai-version.js --sync"
  },
  "keywords": [
    "chat",
    "interno",
    "comunicacao"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.1.1",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.5.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "nodemon": "^3.1.14"
  }
}
